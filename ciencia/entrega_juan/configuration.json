  "questions": {
    "Q1": {
      "hypothesis": "H1",
      "text": "¿Una discontinuidad resuelta intersecta el corredor de ±10 m?",
      "contexts": [
        "cresta",
        "hondonada",
        "arena"
      ],
      "method": "boolean",
      "positive": "Intersección observada",
      "negative": "Ausencia en corredor completamente observable"
    },
    "Q2": {
      "hypothesis": "H2",
      "text": "¿El indicador de mineral hidratado es mayor en la cresta que en la hondonada?",
      "contexts": [
        "par_cresta_hondonada"
      ],
      "method": "difference",
      "quantity": "indicador_cresta − indicador_hondonada"
    },
    "Q3": {
      "hypothesis": "H3",
      "text": "¿El horizonte topográfico bloquea el Sol en el escenario definido?",
      "contexts": [
        "cresta",
        "hondonada",
        "arena",
        "planicie"
      ],
      "method": "difference",
      "quantity": "elevacion_horizonte − elevacion_solar"
    },
    "Q4": {
      "hypothesis": "H4",
      "text": "¿La planicie tiene menor amplitud térmica diaria que la hondonada?",
      "contexts": [
        "par_planicie_hondonada"
      ],
      "method": "difference",
      "quantity": "amplitud_hondonada − amplitud_planicie"
    },
    "Q5": {
      "hypothesis": "H5",
      "text": "¿El segmento cruza un contacto cartografiado entre unidades sedimentarias distintas?",
      "contexts": [
        "cresta",
        "hondonada",
        "arena",
        "planicie"
      ],
      "method": "boolean",
      "positive": "Cruce validado",
      "negative": "Segmento en una unidad fuera de la incertidumbre de contactos"
    }
  },

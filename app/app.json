{
  "expo": {
    "name": "MARSNOVA",
    "slug": "marsnova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MARSNOVA usa tu ubicación para seguir tu recorrido sobre el mapa y avisarte si te sales de la ruta."
        }
      ]
    ],
    "scheme": "marsnova",
    "backgroundColor": "#0B0D12",
    "experiments": {
      "typedRoutes": true
    }
  }
}
